+ cat /etc/mkinitcpio.conf.d/zz-gpu-unlock.conf
# Put gpu_unlock and its firmware in every image and load it right before
# nvidia, so a display card's screen is blank only from its unlock until
# nvidia-drm takes over. Without nvidia in the image it loads last, still
# before any nvidia loaded from the root filesystem. Named to be read after
# every other drop-in. It does nothing unless gpu_unlock.targets= is on the
# kernel command line.
[[ ${MODULES@a} == *a* ]] || read -ra MODULES <<<"$MODULES"
_gu_modules=()
for _gu_module in "${MODULES[@]}"; do
    [[ ${_gu_module%\?} == gpu_unlock ]] && continue
    [[ ${_gu_module%\?} == nvidia ]] && _gu_modules+=(gpu_unlock?)
    _gu_modules+=("$_gu_module")
done
[[ " ${_gu_modules[*]} " == *' gpu_unlock? '* ]] || _gu_modules+=(gpu_unlock?)
MODULES=("${_gu_modules[@]}")
unset _gu_modules _gu_module
