+ set -euo pipefail
++ dirname -- run.sh
+ cd -- .
+ action=vllm
+ label=unlocked
+ system=rtx3080
+ [[ ! unlocked =~ ^[a-zA-Z0-9_-]+$ ]]
+ [[ ! rtx3080 =~ ^[a-zA-Z0-9_-]+$ ]]
+ [[ vllm != help ]]
+ [[ 1 != 1 ]]
+ mkdir -p cache model
+ [[ ! -f image.lock ]]
++ cat image.lock
+ image=vllm/vllm-openai@sha256:c2914767605584b6d8f45686b82de173ecc99e781897aa3d0a66dacd72c51ae1
+ common=(--rm --user "$(id -u):$(id -g)" --shm-size 1g -v "$PWD:/bench" -w /bench -e HOME=/bench/cache -e HF_HOME=/bench/cache/huggingface -e VLLM_CACHE_ROOT=/bench/cache/vllm -e TRITON_CACHE_DIR=/bench/cache/triton -e OMP_NUM_THREADS=1)
++ id -u
++ id -g
+ case "$action" in
++ date -u +%Y%m%dT%H%M%S.%NZ
