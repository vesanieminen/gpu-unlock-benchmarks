+ set -euo pipefail
++ dirname -- run.sh
+ cd -- .
+ action=vllm
+ label=baseline
+ system=rtx3080
+ [[ ! baseline =~ ^[a-zA-Z0-9_-]+$ ]]
+ [[ ! rtx3080 =~ ^[a-zA-Z0-9_-]+$ ]]
+ [[ vllm != help ]]
+ [[ 1 != 1 ]]
+ mkdir -p cache model
+ [[ ! -f image.lock ]]
++ cat image.lock
+ image=vllm/vllm-openai@sha256:c2914767605584b6d8f45686b82de173ecc99e781897aa3d0a66dacd72c51ae1
+ common=(--rm --user "$(id -u):$(id -g)" --shm-size 1g -v "$PWD:/bench" -w /bench -e HOME=/bench/cache -e HF_HOME=/bench/cache/huggingface -e VLLM_CACHE_ROOT=/bench/cache/vllm -e TRITON_CACHE_DIR=/bench/cache/triton -e OMP_NUM_THREADS=6)
++ id -u
++ id -g
+ case "$action" in
++ date -u +%Y%m%dT%H%M%S.%NZ
+ out=systems/rtx3080/results/baseline-vllm-20261025T160334.280146955Z
+ mkdir -p systems/rtx3080/results
+ mkdir systems/rtx3080/results/baseline-vllm-20261025T160334.280146955Z
+ nvidia-smi -q
+ cat /proc/cmdline
+ uname -a
+ cp image.lock systems/rtx3080/results/baseline-vllm-20261025T160334.280146955Z/
+ sha256sum run.sh record.py torch_bench.py vllm_bench.py download.py
+ [[ ! -f model.lock.json ]]
+ cp model.lock.json systems/rtx3080/results/baseline-vllm-20261025T160334.280146955Z/
+ monitor=20363
+ trap 'kill "$monitor" 2>/dev/null || true' EXIT
+ nvidia-smi --query-gpu=timestamp,name,pstate,temperature.gpu,power.draw,power.limit,clocks.sm,clocks.mem,utilization.gpu,memory.used --format=csv -l 1
+ docker run --rm --user 1000:1000 --shm-size 1g -v /home/vesanieminen/Projects/gpu-unlock-benchmarks:/bench -w /bench -e HOME=/bench/cache -e HF_HOME=/bench/cache/huggingface -e VLLM_CACHE_ROOT=/bench/cache/vllm -e TRITON_CACHE_DIR=/bench/cache/triton -e OMP_NUM_THREADS=6 --network none --device nvidia.com/gpu=all -e HF_HUB_OFFLINE=1 -e TRANSFORMERS_OFFLINE=1 -e BENCH_TP=1 -e BENCH_GPU=0 --entrypoint python3 vllm/vllm-openai@sha256:c2914767605584b6d8f45686b82de173ecc99e781897aa3d0a66dacd72c51ae1 vllm_bench.py --output /bench/systems/rtx3080/results/baseline-vllm-20261025T160334.280146955Z/result.json
+ tee systems/rtx3080/results/baseline-vllm-20261025T160334.280146955Z/run.log
