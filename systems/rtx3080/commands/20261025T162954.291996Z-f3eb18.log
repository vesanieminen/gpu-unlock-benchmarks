# SPDX-License-Identifier: GPL-2.0-only
PACKAGE_NAME="gpu-unlock"
PACKAGE_VERSION="1.0.0"
BUILT_MODULE_NAME[0]="gpu_unlock"
DEST_MODULE_LOCATION[0]="/updates/dkms"
AUTOINSTALL="yes"
# Build for each kernel instead of letting RHEL's weak-modules link one
# kernel's build into the others: removing the package then leaves links
# behind that break dracut for those kernels.
