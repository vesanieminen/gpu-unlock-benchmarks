# SPDX-License-Identifier: GPL-2.0-only
# Builds from the committed HEAD of the checkout this file lives in:
#   cd packaging/arch && makepkg -si
# For a published release, point the first source at the tagged tarball.
pkgbase=gpu-unlock
pkgname=(gpu-unlock-dkms gpu-unlock-firmware)
pkgver=1.0.0
pkgrel=1
_nv=610.43.03
_utils=nvidia-utils-$_nv-1-x86_64_v3.pkg.tar.zst
pkgdesc='RTX 3090 BF16 unlock before the NVIDIA driver loads'
arch=('x86_64')
url=''
license=('GPL-2.0-only')
makedepends=('git' 'python' 'zstd')
options=('!strip' '!debug')
source=("$pkgbase::git+file://${startdir%/packaging/arch}"
        "https://download.nvidia.com/XFree86/NVIDIA-kernel-module-source/NVIDIA-kernel-module-source-$_nv.tar.xz"
        "https://archive.cachyos.org/archive/cachyos-v3/$_utils")
noextract=("$_utils")
sha256sums=('SKIP'
            '7e118923c7a23edc36114d63273a46e3e04e9af98695a42203e7ac2dfe9fc1dc'
            'e17e7c92eeffa178b0fe1f40eb17a47095f8fc3ce4a77bf115cf5bd5a4df86e9')

prepare() {
  cd $pkgbase
  test "$(cat VERSION)" = "$pkgver"
}

build() {
  cd $pkgbase
  python firmware/generate_v67.py "$(realpath "$srcdir/$_utils")" "$srcdir/assets"
  python firmware/extract_boot_assets.py "$srcdir/NVIDIA-kernel-module-source-$_nv" "$srcdir/assets"
}

check() {
  cd $pkgbase
  make test ASSETS="$srcdir/assets"
}

package_gpu-unlock-dkms() {
  arch=('any')
  depends=('dkms' "gpu-unlock-firmware=$pkgver-$pkgrel")
  backup=('etc/mkinitcpio.conf.d/zz-gpu-unlock.conf')
  conflicts=('gpu-unlock-mkinitcpio')
  replaces=('gpu-unlock-mkinitcpio')
  install=gpu-unlock.install
  cd $pkgbase
  make DESTDIR="$pkgdir" install-dkms install-mkinitcpio
  make DESTDIR="$pkgdir" PKG=$pkgname install-licenses
}

package_gpu-unlock-firmware() {
  pkgdesc='Locally generated, pinned NVIDIA 610.43.03 firmware assets for gpu-unlock'
  license=('LicenseRef-NVIDIA' 'GPL-2.0-only')
  cd $pkgbase
  make DESTDIR="$pkgdir" ASSETS="$srcdir/assets" install-firmware
}
+ cat /home/vesanieminen/Projects/gpu-unlock/packaging/boot/mkinitcpio.conf
# Put gpu_unlock and its firmware in every image and load it right before
# nvidia, so a display card's screen is blank only from its unlock until
# nvidia-drm takes over. Without nvidia in the image it loads last, still
# before any nvidia loaded from the root filesystem. Named to be read after
# every other drop-in. It does nothing unless gpu_unlock.targets= is on the
# kernel command line.
[[ ${MODULES@a} == *a* ]] || read -ra MODULES <<<"$MODULES"
_gu_modules=()
for _gu_module in "${MODULES[@]}"; do
    [[ ${_gu_module%\?} == gpu_unlock ]] && continue
    [[ ${_gu_module%\?} == nvidia ]] && _gu_modules+=(gpu_unlock?)
    _gu_modules+=("$_gu_module")
done
[[ " ${_gu_modules[*]} " == *' gpu_unlock? '* ]] || _gu_modules+=(gpu_unlock?)
MODULES=("${_gu_modules[@]}")
unset _gu_modules _gu_module
